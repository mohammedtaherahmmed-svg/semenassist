{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SemenAssist expert-reviewed morphology annotation manifest",
  "description": "Research dataset contract. Not a clinical scoring specification. Patient/sample-level splits must prevent leakage.",
  "type": "object",
  "required": ["sample_id", "image_path", "preparation", "pixel_size_um", "reviewer_id", "adjudication_status", "objects"],
  "properties": {
    "sample_id": {"type": "string", "minLength": 1, "description": "Pseudonymous sample identifier; no patient identifiers."},
    "image_path": {"type": "string", "minLength": 1},
    "preparation": {"type": "string", "enum": ["stained", "unstained", "unknown"]},
    "pixel_size_um": {"type": "number", "exclusiveMinimum": 0},
    "microscope_id": {"type": "string"},
    "objective_magnification": {"type": "number", "exclusiveMinimum": 0},
    "reviewer_id": {"type": "string", "minLength": 1},
    "adjudication_status": {"type": "string", "enum": ["single-review", "adjudicated", "unresolved"]},
    "split": {"type": "string", "enum": ["train", "validation", "test"], "description": "Assign by sample/patient, never by image/frame."},
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["object_id", "head_mask", "tail_mask", "labels"],
        "properties": {
          "object_id": {"type": "string"},
          "head_mask": {"type": ["string", "null"], "description": "Path to expert-labelled head mask."},
          "tail_mask": {"type": ["string", "null"], "description": "Path to expert-labelled tail mask."},
          "midpiece_mask": {"type": ["string", "null"]},
          "labels": {
            "type": "object",
            "required": ["head_shape", "tail_status", "overlap", "debris"],
            "properties": {
              "head_shape": {"type": "string", "enum": ["normal", "round", "tapered", "amorphous", "small", "large", "vacuolated", "not-assessable"]},
              "tail_status": {"type": "string", "enum": ["normal", "bent", "coiled", "multiple", "absent", "not-assessable"]},
              "overlap": {"type": "boolean"},
              "debris": {"type": "boolean"}
            }
          }
        }
      }
    }
  }
}
